    <string name="about_contrib_vern_title">Vern (KuatoDev)</string>
    <string name="about_contrib_vern_desc">Arsitektur aplikasi Android, implementasi Kotlin, UI Jetpack Compose, dan integrasi Google OAuth.</string>
    <string name="about_contrib_werdik_title">Werdik (werdio325-png)</string>
    <string name="about_contrib_werdik_desc">Environment userspace Android (env/), package manager pkg (Bash/AWK), dan scheduler agy-daemon.</string>
    <string name="about_contrib_termux_title">Termux Project</string>
    <string name="about_contrib_termux_desc">Bootstrap rootfs userspace Bionic ARM64 Android, repositori package native, dan libtermux-exec.</string>
    <string name="about_contrib_deepmind_title">Google DeepMind</string>
    <string name="about_contrib_deepmind_desc">Binary inti language_server resmi Antigravity, protokol agen, dan API Cloud Code Assist.</string>
    <string name="about_mod_core_title">modules/core</string>
    <string name="about_mod_core_desc">Bundling server inti, packaging binary pristine, dan shim sistem.</string>
    <string name="about_mod_env_title">modules/env</string>
    <string name="about_mod_env_desc">Bridge runtime userspace, utilitas diagnostik, dan CLI environment runner.</string>
    <string name="about_mod_io_title">modules/io</string>
    <string name="about_mod_io_desc">Pemisahan stream antar-proses, pipa FIFO input/output, dan event broker.</string>
    <string name="about_mod_patches_title">modules/patches</string>
    <string name="about_mod_patches_desc">Patcher binary ELF penahan panjang byte, relokasi simbol, dan hook pty_shell.</string>
    <string name="about_mod_runner_title">modules/runner</string>
    <string name="about_mod_runner_desc">Siklus hidup daemon server inti, probe runtime, dan health check otomatis.</string>
    <string name="about_lib_compose_title">Jetpack Compose &amp; Material 3</string>
    <string name="about_lib_compose_desc">Framework UI reaktif modern dan sistem desain dinamis Material 3.</string>
    <string name="about_lib_coroutines_title">Kotlin Coroutines &amp; Flow</string>
    <string name="about_lib_coroutines_desc">Manajemen status asinkron dan aliran event reaktif real-time.</string>
    <string name="about_lib_bionic_title">Android Bionic &amp; NDK</string>
    <string name="about_lib_bionic_desc">Eksekusi binary native ARM64 dan userspace environment.</string>
    <string name="about_lib_coil_title">Coil Compose</string>
    <string name="about_lib_coil_desc">Pemuatan gambar dan avatar pengguna secara asinkron.</string>
    <string name="about_lib_datastore_title">AndroidX DataStore</string>
    <string name="about_lib_datastore_desc">Penyimpanan nilai kunci transaksional dan asinkron untuk pengaturan aplikasi.</string>

